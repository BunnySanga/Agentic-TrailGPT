# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
# Comma-separated key pool for the parallel runner
GROQ_API_KEYS=

# Groq model id
MODEL=openai/gpt-oss-120b
# gpt-oss reasoning level: low keeps output tokens (daily cap) down
GROQ_REASONING_EFFORT=low

# Default --limit: first N patients in dataset order (0 = all; finished ones are skipped)
PATIENT_LIMIT=1

# Parallel runner (run_parallel.py): patients processed at the same time
MAX_WORKERS=3
# Stop cleanly when every key is rate limited for longer than this
KEY_MAX_WAIT_SECONDS=900
